#!/bin/sh
# pre-commit — 提交前快速门禁（照 rpiv-mono 的 husky 分层：commit 快、push 全）。
#
# 只做「几秒内能跑完」的检查：语法 + 图谱自洽 + 测试门禁脚本自检。
# 全量测试放 pre-push（那要几十秒，不该卡每次提交）。
#
# 跳过（确有急事时）：git commit --no-verify

set -e

echo "▸ 语法检查（所有 src/bin/hooks 的 .js/.ts 能解析）..."
node --experimental-vm-modules --no-warnings scripts/check-syntax.mjs || exit 1

echo "▸ 图谱 lint（改了 .brain/ 才跑，避免无关提交变慢）..."
if git diff --cached --name-only | grep -q '^\.brain/'; then
  # 坑（2026-10-05 实测第一次就踩）：`abs lint` **有问题也返回退出码 0**
  #   （它把问题打到 stdout，不是失败退出）。只判 $? 会让门禁形同虚设 ——
  #   实测 lint 报了 ROOT-OVER-SIZE 却照样放行。
  #   故按**输出内容**判：出现 "problem(s)" / 错误码则拦。
  LINT_OUT=$(node bin/abs.js lint 2>&1)
  echo "$LINT_OUT" | tail -3
  # 判据要排除「0 problem(s)」这个成功形态 —— 首版 `grep -qE 'problem\(s\)'`
  # 把 "lint: 0 problem(s)." 也判成失败，于是门禁在干净仓库上恒拦。
  # 正解：出现非零计数，或出现错误码行（大写开头 + 冒号）。
  if echo "$LINT_OUT" | grep -qE 'lint: [1-9][0-9]* problem' || echo "$LINT_OUT" | grep -qE '^[A-Z][A-Z-]+:'; then
    echo "❌ 图谱 lint 未过。修完再提交（或 --no-verify 跳过）。"
    exit 1
  fi
else
  echo "  （本次未改 .brain/，跳过）"
fi

echo "✓ pre-commit 通过"

# ---------------------------------------------------------------------------
# todo 对齐门（2026-10-05 用户要求验证）
#
# 为何加在这里：前 12 次尝试（自动登记 3 版 / 指引 3 版 / 注入提醒 2 版 /
# 面板 / Rule / 每轮摆看板）全部失败 —— 共同点是「靠提醒」，而提醒会被忽略。
# 唯一被证明有效的是**门禁**（不提交就发不出去，今晚跑了 4 次零抱怨）。
#
# 关键：**不猜「这是不是任务」**（auto-todo 三版的教训），只做
# **客观对比**：这次提交里有没有代码，有没有 todo 变更。
# 判断权仍在 LLM/人手里 —— 门禁只负责把这两件事摆在一起，逼一次显式决定。
#
# 逃生口：确有纯重构/纯测试不需要记的，加 --no-todo（或 ABS_NO_TODO=1）。
# ---------------------------------------------------------------------------
if [ -z "$ABS_NO_TODO" ]; then
  STAGED=$(git diff --cached --name-only)
  CODE_CHANGED=$(echo "$STAGED" | grep -cE '^(src/|bin/|hooks/)' || true)
  TODO_CHANGED=$(echo "$STAGED" | grep -c '^\.brain/todo\.md' || true)
  if [ "$CODE_CHANGED" -gt 0 ] && [ "$TODO_CHANGED" -eq 0 ]; then
    echo ""
    echo "⚠ 本次提交改了代码，但 .brain/todo.md 没动。"
    echo "  问自己：这次改的算哪条任务？"
    echo "    · 是某条的推进 → abs todo note <id> --note \"<到哪步>\""
    echo "    · 是新任务       → abs todo add <id> --note \"<做什么>\""
    echo "    · 做完了         → abs todo done <id> --as 落地 \"<结论>\""
    echo "    · 确实不用记     → ABS_NO_TODO=1 git commit ...  （显式跳过）"
    echo ""
    echo "  （不阻塞 —— 机器不知道这是不是任务，只把两件事摆在一起）"
    echo ""
    # 不 exit 1：判断权在 LLM/人。只提示，但要看得见（空行隔开，不被其它输出淹没）。
  fi
fi
